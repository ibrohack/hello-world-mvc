logs/
*.log

# IDE settings
.idea/
*.iml
.vscode/
nbproject/
nb-configuration.xml
.classpath
.project
.settings/
.factorypath

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Reference documents such as the assignment statement
/*.pdf
